diff --git a/tests/test_paper_fills.py b/tests/test_paper_fills.py
new file mode 100644
index 0000000..dd00bc9
--- /dev/null
+++ b/tests/test_paper_fills.py
@@ -0,0 +1,49 @@
+"""Paper fill model: queue ahead, at-price prints, trade-through, book cross."""
+from polymaker.domain import OpenOrder, Side
+from polymaker.marketdata.orderbook import OrderBook
+from polymaker.marketdata.parse import TradePrint
+from tests.test_hardening2 import _engine_with_market
+
+
+def _setup(tmp_path, meta):
+    eng = _engine_with_market(tmp_path, meta)
+    eng.paper = True
+    tok = meta.yes.token_id
+    b = OrderBook()
+    b.apply_snapshot([(0.40, 100.0), (0.39, 50.0)], [(0.42, 80.0)], 0.0, None)
+    eng.md.books[tok] = b
+    o = OpenOrder("paper-0-1", tok, Side.BUY, 0.40, 50.0)
+    eng.state.upsert_order(o)
+    eng._paper_ahead[o.order_id] = eng._paper_level_size(tok, Side.BUY, 0.40)
+    return eng, tok, b
+
+
+def test_queue_then_fill(tmp_path, meta):
+    eng, tok, _ = _setup(tmp_path, meta)
+    cid = meta.condition_id
+    assert eng._paper_ahead["paper-0-1"] == 100.0
+    eng._on_trade(TradePrint(tok, cid, Side.SELL, 0.40, 60.0, 1.0))   # eats queue only
+    assert eng.state.position(tok).size == 0
+    eng._on_trade(TradePrint(tok, cid, Side.BUY, 0.40, 500.0, 1.5))   # wrong aggressor: ignored
+    assert eng.state.position(tok).size == 0
+    eng._on_trade(TradePrint(tok, cid, Side.SELL, 0.40, 70.0, 2.0))   # 40 queue, 30 to us
+    assert eng.state.position(tok).size == 30
+    eng._on_trade(TradePrint(tok, cid, Side.SELL, 0.38, 99.0, 3.0))   # through: last 20
+    assert eng.state.position(tok).size == 50
+    assert eng.state.orders_for(tok) == []
+
+
+def test_book_cross_fills(tmp_path, meta):
+    eng, tok, b = _setup(tmp_path, meta)
+    b.apply_delta(Side.SELL, 0.40, 25.0, 1.0)  # an ask lands on our bid price
+    eng._on_dirty(meta.condition_id, tok)
+    assert eng.state.position(tok).size == 25
+
+
+def test_level_emptied_moves_us_to_front(tmp_path, meta):
+    eng, tok, b = _setup(tmp_path, meta)
+    b.apply_delta(Side.BUY, 0.40, 0.0, 1.0)    # everyone ahead cancelled
+    eng._on_dirty(meta.condition_id, tok)
+    assert eng._paper_ahead["paper-0-1"] == 0.0
+    eng._on_trade(TradePrint(tok, meta.condition_id, Side.SELL, 0.40, 10.0, 2.0))
+    assert eng.state.position(tok).size == 10

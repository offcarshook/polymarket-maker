+def test_fill_cooloff_blocks_rebuying_but_not_exits(tmp_path, meta):
+    import time as _t
+    from polymaker.config import StrategyProfile
+    from polymaker.domain import Fill, Quote
+
+    eng = _engine_with_market(tmp_path, meta)
+    p = StrategyProfile(fill_cooloff_s=30.0)
+    tok = meta.yes.token_id
+    eng._on_fill(Fill(tok, Side.BUY, 0.40, 10.0, "f1", ts=_t.time()))
+    q = [Quote(tok, Side.BUY, 0.39, 10.0), Quote(tok, Side.SELL, 0.42, 10.0),
+         Quote(meta.no.token_id, Side.BUY, 0.58, 10.0)]
+    kept = eng._fill_cooloff_trim(p, q)
+    assert [x.side for x in kept if x.token_id == tok] == [Side.SELL]   # no re-buy, exit allowed
+    assert any(x.token_id == meta.no.token_id for x in kept)            # other side unaffected
+    assert eng._fill_cooloff_trim(StrategyProfile(), q) == q             # off by default

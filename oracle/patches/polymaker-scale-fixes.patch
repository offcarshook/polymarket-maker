+                                               "size": size, "why": why, "print_px": print_px}, ts)
+            log.info("paper_fill", cid=cid[:8], side=o.side.value, price=o.price,
+                     size=round(size, 2), why=why)
+        o.size -= size
+        if o.size <= 1e-9:

+    def _paper_fill(self, cid: str, tp: TradePrint) -> None:
+        """PAPER ONLY: simulate maker fills from public trade prints so inventory,
+        position caps, inventory skew and the toxicity estimator behave like live
+        (without this, paper mode never sees a fill and always believes it is flat).
+        Conservative rule: a resting order fills only when a print trades strictly
+        through its price; touching it doesn't count (no queue model)."""
+        remaining = tp.size
+        orders = sorted(self.state.orders_for(tp.asset_id), key=lambda o: o.price,
+                        reverse=True)
+        for o in orders:
+            if remaining <= 0:
+                break
+            through = tp.price < o.price if o.side is Side.BUY else tp.price > o.price
+            if not through or o.size <= 0:
+                continue
+            take = min(remaining, o.size)
+            remaining -= take
+            fill = Fill(o.token_id, o.side, o.price, take,
+                        trade_id=f"paper-{o.order_id}-{int(tp.ts * 1000)}", ts=tp.ts)
+            if self.state.apply_fill(fill):
+                self._on_fill(fill)
+                log.info("paper_fill", cid=cid[:8], side=o.side.value, price=o.price,
+                         size=round(take, 2), print_px=tp.price)
+            o.size -= take
+            if o.size <= 1e-9:
+                self.state.remove_order(o.order_id)
+        if remaining < tp.size:
+            self._dirty[cid].set()  # requote with the new inventory
+
     def _on_fill(self, fill: Fill) -> None:
         self.risk.note_fill(fill)
         cid = self._token_cid.get(fill.token_id)

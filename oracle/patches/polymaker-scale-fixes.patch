+    def _paper_fill(self, cid: str, tp: TradePrint) -> None:
+        remaining = tp.size
+        for o in sorted(self.state.orders_for(tp.asset_id), key=lambda o: o.price,
+                        reverse=True):
+            if remaining <= 1e-9:

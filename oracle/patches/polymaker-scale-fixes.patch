+def test_paired_yes_no_frees_paper_capital(tmp_path, meta):
+    """A YES+NO pair merges back to $1, so it must not tie up the paper budget."""
+    from polymaker.config import StrategyProfile
+    from polymaker.domain import Fill, Quote
+
+    eng = _engine_with_market(tmp_path, meta)
+    eng.paper = True
+    p = StrategyProfile(paper_capital_usdc=30.0)
+    eng.profiles[meta.condition_id] = p
+    eng.state.apply_fill(Fill(meta.yes.token_id, Side.BUY, 0.40, 100.0, "y1"))  # $40 YES
+    eng.state.apply_fill(Fill(meta.no.token_id, Side.BUY, 0.55, 100.0, "n1"))   # $55 NO
+    q = [Quote(meta.yes.token_id, Side.BUY, 0.40, 50.0)]                         # $20 new bid
+    assert eng._paper_capital_trim(meta.condition_id, p, q) == q  # 100 pairs = cash, not risk
+    eng.state.apply_fill(Fill(meta.yes.token_id, Side.BUY, 0.40, 50.0, "y2"))   # +50 unpaired YES = $20
+    assert eng._paper_capital_trim(meta.condition_id, p, q) == []  # 20 held + 20 new > 30
+

+    # ── paper fill simulator (PAPER ONLY) ───────────────────────────────
+    # Without this, paper mode never sees a fill and always believes it is flat,
+    # so position caps, inventory skew and the toxicity estimator never engage.
+    # A paper order rests virtually in the real book and fills when:
+    #   1. a print trades strictly THROUGH its price (all of it can fill);
+    #   2. a print trades AT its price against it, after the displayed size that
+    #      was queued ahead when we joined (price-time priority) is used up;
+    #   3. the book crosses it (best ask <= our bid): that aggressive order would
+    #      have matched our resting order first.
+    # Queue position only improves when the level empties (no cancel modelling).
+    async def _paper_book_dump_loop(self) -> None:
+        """PAPER ONLY: re-journal full books every 10 min so offline tools (markout,
+        rewards estimate) can rebuild complete depth after the journal is trimmed."""
+        while self._running:
+            await asyncio.sleep(600)
+            now = time.time()
+            for tok, book in list(self.md.books.items()):
+                self.journal.write("book", {
+                    "asset_id": tok, "source": "paper_dump",
+                    "bids": [{"price": p, "size": sz} for p, sz in book.bids.items()],
+                    "asks": [{"price": p, "size": sz} for p, sz in book.asks.items()],
+                }, now)
+
+    def _paper_level_size(self, token_id: str, side: Side, price: float) -> float:
+        book = self.md.books.get(token_id)
+        if book is None:
+            return float("inf")  # unknown queue: only trade-throughs/crosses fill
+        lvl = book.bids if side is Side.BUY else book.asks
+        return float(lvl.get(price, 0.0))
+
+    def _paper_apply(self, cid: str, o: Any, size: float, ts: float, why: str,
+                     print_px: float | None = None) -> None:

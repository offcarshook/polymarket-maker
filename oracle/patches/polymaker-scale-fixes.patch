+def test_reward_band_frac_sits_back_and_sizes_to_min(meta):
+    from polymaker.config import StrategyProfile
+    from polymaker.strategy.quoting import construct_quotes
+    from tests.test_quoting import _inputs
+
+    touch = construct_quotes(_inputs(meta, StrategyProfile())).quotes
+    farm = construct_quotes(_inputs(meta, StrategyProfile(
+        reward_band_frac=0.8, reward_min_sizing=True, layers=1))).quotes
+    yes = meta.yes.token_id
+    t_bid = max(q.price for q in touch if q.token_id == yes and q.side is Side.BUY)
+    f_bids = [q for q in farm if q.token_id == yes and q.side is Side.BUY]
+    assert f_bids and max(q.price for q in f_bids) <= t_bid         # never closer than default
+    assert 0.50 - min(q.price for q in f_bids) < 0.03 - 1e-9        # strictly inside the 3c band
+    assert all(q.size == meta.rewards_min_size for q in f_bids)     # exactly the reward min

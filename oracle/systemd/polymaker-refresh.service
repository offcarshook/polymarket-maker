[Unit]
Description=rescan markets, re-pick, restart the paper bot

[Service]
Type=oneshot
User=@USER@
WorkingDirectory=@APP@
ExecStart=@UV@ run python my_tools/scan_tags.py
ExecStart=@APP@/.venv/bin/python -I my_tools/ab_pick.py @PICK_ARGS@
ExecStartPost=+/bin/systemctl restart polymaker-paper.service

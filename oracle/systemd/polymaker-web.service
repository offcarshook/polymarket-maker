[Unit]
Description=polymaker dashboard web server (localhost only)

[Service]
User=@USER@
WorkingDirectory=@APP@
# 127.0.0.1 only: reach it through Tailscale serve or an SSH tunnel, never the open internet
ExecStart=@APP@/.venv/bin/python -m http.server 8080 --bind 127.0.0.1 --directory web
Restart=always
Nice=15
RestartSec=5

[Install]
WantedBy=multi-user.target
